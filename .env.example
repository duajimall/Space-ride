# Neon Postgres (or any Postgres) connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="cosmic-music-box"
# Public base URL for the bucket (r2.dev URL or your own custom domain)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Password that unlocks the owner (import) dashboard
OWNER_PASSWORD="change-me"
# Any random long string, used to sign the owner session cookie
OWNER_SECRET="change-me-too"
